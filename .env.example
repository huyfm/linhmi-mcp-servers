# Copy to `.env` and fill in real values:  cp .env.example .env
# The real .env holds your Personal Access Token — it is gitignored. Never commit it.
# The same .env drives the Azure deploy (infra/main.bicepparam reads these vars).

# ---------------------------------------------------------------------------
# Azure deploy (used by scripts/deploy-azure.sh + infra/main.bicepparam)
# ---------------------------------------------------------------------------
AZURE_REGION=southeastasia
AZURE_RESOURCE_GROUP=claude-mcp-rg
AZURE_CONTAINERAPP=vnpay-atlassian-mcp
# The auth-proxy image is pushed to PUBLIC ghcr.io and pulled anonymously (no ACR).
GHCR_USER=replace-with-your-github-username
AUTH_PROXY_IMAGE=vnpay-atlassian-auth-proxy
AUTH_PROXY_TAG=1
# Token to push to ghcr (GitHub PAT with write:packages). Optional if `gh` is logged in.
GHCR_TOKEN=

# ---------------------------------------------------------------------------
# Image version (pin this for supply-chain safety)
# ---------------------------------------------------------------------------
# Find a release tag at https://github.com/sooperset/mcp-atlassian/releases
MCP_ATLASSIAN_TAG=latest

# ---------------------------------------------------------------------------
# Transport (the server now runs as a remote streamable-http service, not stdio)
# ---------------------------------------------------------------------------
# mcp-atlassian listens on this internal port; only the auth-proxy reaches it.
MCP_TRANSPORT=streamable-http
STREAMABLE_HTTP_PATH=/mcp

# ---------------------------------------------------------------------------
# Jira (self-hosted / Data Center) — Personal Access Token auth
# ---------------------------------------------------------------------------
JIRA_URL=https://jira.vnpay.vn
JIRA_PERSONAL_TOKEN=replace-with-your-jira-PAT
# Set to false only if your instance uses an internal/self-signed CA cert.
JIRA_SSL_VERIFY=true

# ---------------------------------------------------------------------------
# Confluence (self-hosted / Data Center) — Personal Access Token auth
# ---------------------------------------------------------------------------
CONFLUENCE_URL=https://confluence.vnpay.vn
CONFLUENCE_PERSONAL_TOKEN=replace-with-your-confluence-PAT
CONFLUENCE_SSL_VERIFY=true

# ---------------------------------------------------------------------------
# READ-ONLY ENFORCEMENT
# ---------------------------------------------------------------------------
# Layer 1: globally disable all create/update/delete/transition/comment operations.
READ_ONLY_MODE=true

# Layer 2: allowlist — only these tools are loaded. This is the COMPLETE set of
# read-only Jira + Confluence tools (no write tools are listed). Comma-separated,
# no spaces.
ENABLED_TOOLS=jira_get_issue,jira_search,jira_get_project_issues,jira_search_fields,jira_get_field_options,jira_get_transitions,jira_get_all_projects,jira_get_project_versions,jira_get_project_components,jira_get_agile_boards,jira_get_board_issues,jira_get_sprints_from_board,jira_get_sprint_issues,jira_get_link_types,jira_get_worklog,jira_download_attachments,jira_get_issue_images,jira_get_user_profile,jira_get_issue_watchers,jira_get_service_desk_for_project,jira_get_service_desk_queues,jira_get_queue_issues,jira_get_issue_proforma_forms,jira_get_proforma_form_details,jira_get_issue_dates,jira_get_issue_sla,jira_get_issue_development_info,jira_get_issues_development_info,jira_batch_get_changelogs,confluence_search,confluence_get_page,confluence_get_page_children,confluence_get_page_history,confluence_get_comments,confluence_get_labels,confluence_search_user,confluence_get_page_views,confluence_get_attachments,confluence_download_attachment,confluence_download_content_attachments,confluence_get_page_images,confluence_get_page_diff

# ---------------------------------------------------------------------------
# auth-proxy — GitHub OAuth gateway in front of the MCP server (auth-proxy/app.py)
# ---------------------------------------------------------------------------
# Create a GitHub OAuth app (Settings > Developer settings > OAuth Apps). Its
# "Authorization callback URL" must be PUBLIC_BASE_URL + /auth/callback.
GITHUB_OAUTH_CLIENT_ID=replace-with-your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-your-github-oauth-client-secret

# The externally reachable https URL of the auth-proxy. In Azure this is the
# Container App ingress FQDN, e.g. https://vnpay-atlassian-mcp.<region>.azurecontainerapps.io
PUBLIC_BASE_URL=https://replace-with-your-container-app-fqdn

# Optional: comma-separated GitHub logins allowed through (no spaces).
# Empty = any GitHub user who completes OAuth on your app is allowed.
ALLOWED_GITHUB_USERS=

# Where the proxy forwards to. Locally docker-compose overrides this to the
# mcp-atlassian service name; in Azure leave it as localhost (same pod).
BACKEND_MCP_URL=http://localhost:9000/mcp

# LOCAL DEV ONLY: set to true to skip GitHub auth entirely so you can test the
# proxy -> mcp-atlassian path without an OAuth round-trip. NEVER set in Azure.
AUTH_DISABLED=false
